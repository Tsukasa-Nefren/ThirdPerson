<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ThirdPerson</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModSharp.Sharp.Shared" Version="*" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="if exist $(ProjectDir)build rmdir /s/q $(ProjectDir)build" />
    <Exec Command="if not exist $(ProjectDir)build mkdir $(ProjectDir)build" />
    <Exec Command="if not exist $(ProjectDir)build\configs\ThirdPerson mkdir $(ProjectDir)build\configs\ThirdPerson" />
    <Exec Command="copy /Y $(TargetDir)$(TargetName).dll $(ProjectDir)build\$(TargetName).dll" />
    <Exec Command="copy /Y $(TargetDir)$(TargetName).deps.json $(ProjectDir)build\$(TargetName).deps.json" />
    <Exec Command="copy /Y $(ProjectDir)config.jsonc $(ProjectDir)build\configs\ThirdPerson\config.jsonc" />
  </Target>

</Project>
